{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "allowJs": true,
    // Opt-in per file: modules with logic (state, api, model, format, diff, labels, catalogs, i18n…) carry
    // `// @ts-check`; DOM glue that only wires events to them does not.
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["js/**/*.js"]
}
