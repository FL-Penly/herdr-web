{
  "name": "herdr-web",
  "version": "0.1.0",
  "description": "Your Claude Code and Codex sessions in herdr, as a chat app in the browser.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/FL-Penly/herdr-web.git" },
  "homepage": "https://github.com/FL-Penly/herdr-web#readme",
  "bugs": "https://github.com/FL-Penly/herdr-web/issues",
  "type": "module",
  "private": true,
  "bin": { "herdr-web": "src/main.ts" },
  "engines": { "bun": ">=1.3.7" },
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "url": "bun src/main.ts --print-url",
    "test": "bun test",
    "typecheck": "tsc && tsc -p public",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "dependencies": {
    "@fontsource/inter": "5.1.0",
    "@fontsource/jetbrains-mono": "5.1.1",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "dompurify": "3.2.4",
    "marked": "12.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "1.2.5",
    "typescript": "5.7.3"
  }
}
